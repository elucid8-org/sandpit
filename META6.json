{
    "name": "Elucid8::Doc-Website",
    "description": "Renders Raku documentation sources to web site",
    "version": "0.7.0",
    "raku": "6.d",
    "authors": [
        "Richard Hainsworth"
    ],
    "auth": "zef:finanalyst",
    "depends": [
        "Rakuast::RakuDoc::Render",
        "RakuConfig",
        "PrettyDump",
        "File::Directory::Tree",
        "Elucid8::Build",
        "Git::Log",
        "JSON::Fast::Hyper",
        "Type-Relations-Digraph",
        "Getopt::Long",
        "LibCurl::Easy"
    ],
    "test-depends": [
        "Test",
        "Test::META"
    ],
    "provides": {
        "Doc-Website::Plugin::PageStyling": "local-lib/PageStyling.rakumod",
        "Doc-Website::Plugin::DataTable": "local-lib/DataTable.rakumod",
        "Doc-Website::Plugin::Search": "local-lib/Search.rakumod",
        "Doc-Website::Plugin::SiteData": "local-lib/SiteData.rakumod",
        "Doc-Website::Plugin::TypeGraphs": "local-lib/TypeGraphs.rakumod",
        "Doc-Website::Plugin::BrowserREPL": "local-lib/BrowserREPL.rakumod",
        "Doc-Website::Plugin::Edit-in-github": "local-lib/Edit-in-github.rakumod",
        "Doc-Website::Plugin::CreditObject": "local-lib/CreditObject.rakumod"
    },
    "support": {
        "email": "richard@hainsworth.wales",
        "bugtracker": "https://github.com/elucid8-org/build/issues",
        "source": "https://github.com/elucid8-org/build.git"
    },
    "license": "Artistic-2.0",
    "source-url": "git://github.com/elucid8-org/sandpit.git",
    "source-type": "git"
}